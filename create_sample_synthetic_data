import pandas as pd
import numpy as np
import random
from datetime import datetime, timedelta
import os

# ============================================================
# CONFIG
# ============================================================

OUTPUT_DIR = "01_platform_modernization_blueprint/data"
NUM_ROWS = 5000
random.seed(42)
np.random.seed(42)

os.makedirs(OUTPUT_DIR, exist_ok=True)

# ============================================================
# Helper Functions
# ============================================================

def random_date(start, end):
    delta = end - start
    return start + timedelta(seconds=random.randint(0, int(delta.total_seconds())))

def random_choice_with_none(options, p_none=0.1):
    return random.choice(options) if random.random() > p_none else None

# ============================================================
# 1. orders.csv
# ============================================================

def generate_orders(n=NUM_ROWS):
    order_ids = [f"ORD-{i:06d}" for i in range(1, n+1)]
    customer_ids = [f"CUST-{random.randint(1, 2000):05d}" for _ in range(n)]
    start_date = datetime(2023, 1, 1)
    end_date = datetime(2025, 12, 1)

    df = pd.DataFrame({
        "order_id": order_ids,
        "customer_id": customer_ids,
        "order_date": [random_date(start_date, end_date) for _ in range(n)],
        "order_status": np.random.choice(["NEW", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"], n),
        "order_total": np.round(np.random.uniform(20, 2000, n), 2),
        "currency": np.random.choice(["USD", "EUR", "GBP"], n),
        "sales_channel": np.random.choice(["ONLINE", "STORE", "DISTRIBUTOR"], n),
        "shipping_method": np.random.choice(["STANDARD", "EXPRESS", "OVERNIGHT"], n),
        "country": np.random.choice(["US", "UK", "DE", "FR", "CA"], n),
        "promo_code": [random_choice_with_none(["HOLIDAY10", "WELCOME5", "SPRING20"], p_none=0.7) for _ in range(n)],
        "created_timestamp": [datetime.now() for _ in range(n)]
    })

    df.to_csv(f"{OUTPUT_DIR}/orders.csv", index=False)
    return df

# ============================================================
# 2. order_items.csv
# ============================================================

def generate_order_items(orders_df):
    rows = []
    for _, row in orders_df.iterrows():
        for _ in range(random.randint(1, 5)):
            rows.append({
                "order_item_id": f"ITEM-{random.randint(1, 999999):06d}",
                "order_id": row["order_id"],
                "sku_id": f"SKU-{random.randint(1, 3000):05d}",
                "quantity": random.randint(1, 10),
                "unit_price": round(random.uniform(5, 500), 2),
                "discount_amount": round(random.uniform(0, 50), 2),
                "tax_amount": round(random.uniform(0, 20), 2)
            })

    df = pd.DataFrame(rows)
    df.to_csv(f"{OUTPUT_DIR}/order_items.csv", index=False)
    return df

# ============================================================
# 3. sales_transactions.csv
# ============================================================

def generate_sales_transactions(n=NUM_ROWS):
    df = pd.DataFrame({
        "transaction_id": [f"TX-{i:06d}" for i in range(1, n+1)],
        "store_id": [f"STORE-{random.randint(1, 200):04d}" for _ in range(n)],
        "sku_id": [f"SKU-{random.randint(1, 3000):05d}" for _ in range(n)],
        "transaction_timestamp": [random_date(datetime(2023,1,1), datetime(2025,12,1)) for _ in range(n)],
        "quantity": np.random.randint(1, 10, n),
        "unit_price": np.round(np.random.uniform(5, 500, n), 2),
        "payment_method": np.random.choice(["CARD", "CASH", "ONLINE"], n),
        "promo_code": [random_choice_with_none(["HOLIDAY10", "SPRING20"], p_none=0.8) for _ in range(n)]
    })

    df.to_csv(f"{OUTPUT_DIR}/sales_transactions.csv", index=False)
    return df

# ============================================================
