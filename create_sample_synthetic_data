    })

    df.to_csv(f"{OUTPUT_DIR}/customer_master.csv", index=False)
    return df

# ============================================================
# 9. returns.csv
# ============================================================

def generate_returns(n=NUM_ROWS):
    df = pd.DataFrame({
        "return_id": [f"RET-{i:06d}" for i in range(1, n+1)],
        "order_id": [f"ORD-{random.randint(1, NUM_ROWS):06d}" for _ in range(n)],
        "sku_id": [f"SKU-{random.randint(1, 3000):05d}" for _ in range(n)],
        "return_date": [random_date(datetime(2023,1,1), datetime(2025,12,1)) for _ in range(n)],
        "return_reason": np.random.choice(["DAMAGED", "NOT_AS_DESCRIBED", "SIZE_ISSUE", "NO_LONGER_NEEDED"], n),
        "refund_amount": np.round(np.random.uniform(5, 500), 2),
        "condition": np.random.choice(["NEW", "USED", "DAMAGED"], n)
    })

    df.to_csv(f"{OUTPUT_DIR}/returns.csv", index=False)
    return df

# ============================================================
# 10. forecast_demand.csv
# ============================================================

def generate_forecast_demand(n=NUM_ROWS):
    pred = np.random.randint(0, 1000, n)
    lower = np.maximum(0, pred - np.random.randint(0, 100, n))
    upper = pred + np.random.randint(0, 100, n)

    df = pd.DataFrame({
        "sku_id": [f"SKU-{random.randint(1, 3000):05d}" for _ in range(n)],
        "forecast_date": [random_date(datetime(2023,1,1), datetime(2025,12,1)).date() for _ in range(n)],
        "predicted_demand": pred,
        "lower_bound": lower,
        "upper_bound": upper
    })

    df.to_csv(f"{OUTPUT_DIR}/forecast_demand.csv", index=False)
    return df


if __name__ == "__main__":
    # Generate datasets (orders first because order_items depends on it)
    orders_df = generate_orders()
    generate_order_items(orders_df)
    generate_sales_transactions()
    generate_procurement_components()
    generate_sku_master()
    generate_supplier_master()
    generate_inventory_snapshots()
    generate_customer_master()
    generate_returns()
    generate_forecast_demand()

    print("Synthetic data generation complete. Files written to:", OUTPUT_DIR)